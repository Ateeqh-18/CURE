# Cure — Multilingual Prescription & Medication Safety Assistant
# ------------------------------------------------------------------
# Strictly server-side AI credentials & configuration (never prefix with NEXT_PUBLIC_)

# Provider A (Primary): Google Gemini Vision Cloud AI (@google/genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Provider B (Local Offline Fallback): Ollama Qwen2.5-VL Vision Model
# Default 3B model is chosen for 16 GB RAM Windows CPU/GPU compatibility.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Optional Chromium/Chrome/Edge path for multilingual PDF rendering (auto-detected on Windows/Linux/macOS)
CHROMIUM_PATH=

# App Configuration
NEXT_PUBLIC_APP_NAME="Cure — Multilingual Prescription & Medication Safety Assistant"
NEXT_PUBLIC_DEMO_MODE=true
